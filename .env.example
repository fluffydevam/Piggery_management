APP_NAME="Piggery Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Local development (default): SQLite
# ---------------------------------------------------------------------------
# Create the file once with:  New-Item database/database.sqlite -ItemType File
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# ---------------------------------------------------------------------------
# Production / Supabase (PostgreSQL)
# ---------------------------------------------------------------------------
# Uncomment the block below (and comment out DB_CONNECTION=sqlite) when you
# want to run migrations against Supabase from your machine. The direct host
# db.<project-ref>.supabase.co is IPv6-only, so always use the Supavisor
# pooler host. Port 5432 = session mode (prepared statements supported),
# port 6543 = transaction mode (requires DB_EMULATE_PREPARES=true).
#
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=
# DB_SSLMODE=require
# DB_EMULATE_PREPARES=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Admin account created by `php artisan db:seed --class=AdminUserSeeder`
# ---------------------------------------------------------------------------
ADMIN_NAME="Farm Admin"
ADMIN_EMAIL=farmer@example.com
ADMIN_PASSWORD=password
